{
  "manifest_version": 3,
  "name": "Pointer — agent browser bridge",
  "version": "0.2.8",
  "description": "Lets any MCP agent drive your real Chrome tab, with a visible pointer you can follow.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "debugger", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Pointer",
    "default_popup": "popup.html"
  }
}
